# ═══════════════════════════════════════════════════════════════════
#  Golden Seafood - Template biến môi trường Production
#  ✅ File NÀY được commit lên Git (không có giá trị thật)
#  📋 Hướng dẫn: Copy file này thành .env.prod rồi điền giá trị thật
# ═══════════════════════════════════════════════════════════════════

# Database
DB_ROOT_PASSWORD=YOUR_STRONG_PASSWORD_HERE
DB_NAME=goldenseafood

# JWT (đặt chuỗi ngẫu nhiên dài, khó đoán)
JWT_SECRET=YOUR_JWT_SECRET_HERE

# SMTP Email
SMTP_HOST=mail.goldenseafood.com.vn
SMTP_PORT=587
SMTP_USER=info@goldenseafood.com.vn
SMTP_PASS=YOUR_SMTP_PASSWORD_HERE
SMTP_FROM_NAME=Golden Seafood
SMTP_FROM_EMAIL=info@goldenseafood.com.vn
NOTIFY_EMAIL=binh@goldenseafood.com.vn
NOTIFY_EMAIL_CC=tram@goldenseafood.com.vn
